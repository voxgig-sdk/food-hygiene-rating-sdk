# Entity: authority

main: kit: entity: authority: {

  alias: field: {}

  fields: {
    Email: {
      fo: "email"
      h: "Email"
      n: "Email"
      r: false
      sh: "Email address of the local authority"
      t: "`$STRING`"
    }
    EstablishmentCount: {
      h: "Establishment Count"
      n: "EstablishmentCount"
      r: false
      sh: "Number of establishments registered with this authority"
      t: "`$INTEGER`"
    }
    FileName: {
      h: "File Name"
      n: "FileName"
      r: false
      sh: "XML filename for the authority's data"
      t: "`$STRING`"
    }
    FileNameWelsh: {
      h: "File Name Welsh"
      n: "FileNameWelsh"
      r: false
      sh: "Welsh language XML filename (for Welsh authorities)"
      t: "`$STRING`"
    }
    FriendlyName: {
      h: "Friendly Name"
      n: "FriendlyName"
      r: false
      sh: "Friendly display name of the local authority"
      t: "`$STRING`"
    }
    LocalAuthorityId: {
      h: "Local Authority Id"
      n: "LocalAuthorityId"
      r: false
      sh: "Unique identifier for the local authority"
      t: "`$INTEGER`"
    }
    LocalAuthorityIdCode: {
      h: "Local Authority Id Code"
      n: "LocalAuthorityIdCode"
      r: false
      sh: "Code for the local authority"
      t: "`$STRING`"
    }
    Name: {
      h: "Name"
      n: "Name"
      r: false
      sh: "Name of the local authority"
      t: "`$STRING`"
    }
    RegionName: {
      h: "Region Name"
      n: "RegionName"
      r: false
      sh: "Region where the authority is located"
      t: "`$STRING`"
    }
    SchemeUrl: {
      fo: "uri"
      h: "Scheme Url"
      n: "SchemeUrl"
      r: false
      sh: "URL to the local authority's food hygiene scheme page"
      t: "`$STRING`"
    }
    Url: {
      fo: "uri"
      h: "Url"
      n: "Url"
      r: false
      sh: "Website URL of the local authority"
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "authority"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /Authorities"
            source: "openapi3"
            version: 2
          }
          m: "GET"
          o: "/Authorities"
          s: [
            {
              lit: "Authorities"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.authorities`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /Authorities/{id}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/Authorities/{id}"
          q: {
            exist: [
              "id"
            ]
          }
          s: [
            {
              lit: "Authorities"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
