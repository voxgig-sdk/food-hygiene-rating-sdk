# Entity: authority

main: kit: entity: authority: {

  alias: field: {}

  fields: [
    {
      name: "email"
      req: false
      type: "`$STRING`"
    }
    {
      name: "establishment_count"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "file_name"
      req: false
      type: "`$STRING`"
    }
    {
      name: "file_name_welsh"
      req: false
      type: "`$STRING`"
    }
    {
      name: "friendly_name"
      req: false
      type: "`$STRING`"
    }
    {
      name: "local_authority_id"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "local_authority_id_code"
      req: false
      type: "`$STRING`"
    }
    {
      name: "name"
      req: false
      type: "`$STRING`"
    }
    {
      name: "region_name"
      req: false
      type: "`$STRING`"
    }
    {
      name: "scheme_url"
      req: false
      type: "`$STRING`"
    }
    {
      name: "url"
      req: false
      type: "`$STRING`"
    }
  ]

  name: "authority"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/Authorities"
          parts: [
            "Authorities"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/Authorities/{id}"
          parts: [
            "Authorities"
            "{id}"
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
