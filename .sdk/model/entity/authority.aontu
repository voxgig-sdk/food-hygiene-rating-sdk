# Entity: authority

main: kit: entity: authority: {

  alias: field: {}

  fields: [
    {
      name: "Email"
      req: false
      type: "`$STRING`"
    }
    {
      name: "EstablishmentCount"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "FileName"
      req: false
      type: "`$STRING`"
    }
    {
      name: "FileNameWelsh"
      req: false
      type: "`$STRING`"
    }
    {
      name: "FriendlyName"
      req: false
      type: "`$STRING`"
    }
    {
      name: "LocalAuthorityId"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "LocalAuthorityIdCode"
      req: false
      type: "`$STRING`"
    }
    {
      name: "Name"
      req: false
      type: "`$STRING`"
    }
    {
      name: "RegionName"
      req: false
      type: "`$STRING`"
    }
    {
      name: "SchemeUrl"
      req: false
      type: "`$STRING`"
    }
    {
      name: "Url"
      req: false
      type: "`$STRING`"
    }
  ]

  name: "authority"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/Authorities"
          parts: [
            "Authorities"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.authorities`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/Authorities/{id}"
          parts: [
            "Authorities"
            "{id}"
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
