# Entity: establishment

main: kit: entity: establishment: {

  alias: field: {}

  fields: [
    {
      name: "AddressLine1"
      req: false
      short: "First line of the address"
      type: "`$STRING`"
    }
    {
      name: "AddressLine2"
      req: false
      short: "Second line of the address"
      type: "`$STRING`"
    }
    {
      name: "AddressLine3"
      req: false
      short: "Third line of the address"
      type: "`$STRING`"
    }
    {
      name: "AddressLine4"
      req: false
      short: "Fourth line of the address"
      type: "`$STRING`"
    }
    {
      name: "BusinessName"
      req: false
      short: "Name of the food establishment"
      type: "`$STRING`"
    }
    {
      name: "BusinessType"
      req: false
      short: "Type of food business (e.g., Restaurant, Pub, Café, Takeaway)"
      type: "`$STRING`"
    }
    {
      name: "BusinessTypeID"
      req: false
      short: "Unique identifier for the business type"
      type: "`$INTEGER`"
    }
    {
      name: "FHRSID"
      req: false
      short: "Unique identifier for the establishment in the FHRS system"
      type: "`$INTEGER`"
    }
    {
      name: "Geocode"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "LocalAuthorityBusinessID"
      req: false
      short: "Business ID assigned by the local authority"
      type: "`$STRING`"
    }
    {
      name: "LocalAuthorityCode"
      req: false
      short: "Code for the local authority"
      type: "`$STRING`"
    }
    {
      name: "LocalAuthorityEmailAddress"
      req: false
      short: "Email address of the local authority"
      type: "`$STRING`"
    }
    {
      name: "LocalAuthorityName"
      req: false
      short: "Name of the local authority"
      type: "`$STRING`"
    }
    {
      name: "LocalAuthorityWebSite"
      req: false
      short: "Website of the local authority"
      type: "`$STRING`"
    }
    {
      name: "NewRatingPending"
      req: false
      short: "Indicates if a new rating is pending"
      type: "`$BOOLEAN`"
    }
    {
      name: "PostCode"
      req: false
      short: "Postcode of the establishment"
      type: "`$STRING`"
    }
    {
      name: "RatingDate"
      req: false
      short: "Date the rating was issued"
      type: "`$STRING`"
    }
    {
      name: "RatingKey"
      req: false
      short: "Key for the rating value"
      type: "`$STRING`"
    }
    {
      name: "RatingValue"
      req: false
      short: "The food hygiene rating (0-5 for FHRS, Pass/Improvement Required/Exempt for FHIS)"
      type: "`$STRING`"
    }
    {
      name: "SchemeType"
      req: false
      short: "Type of scheme (FHRS or FHIS)"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "latitude"
      req: false
      short: "Latitude coordinate of the establishment"
      type: "`$NUMBER`"
    }
    {
      name: "longitude"
      req: false
      short: "Longitude coordinate of the establishment"
      type: "`$NUMBER`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "establishment"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                kind: "query"
                name: "address"
                orig: "address"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "business_type_id"
                orig: "business_type_id"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                kind: "query"
                name: "latitude"
                orig: "latitude"
                reqd: false
                type: "`$NUMBER`"
              }
              {
                kind: "query"
                name: "local_authority_id"
                orig: "local_authority_id"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                kind: "query"
                name: "longitude"
                orig: "longitude"
                reqd: false
                type: "`$NUMBER`"
              }
              {
                kind: "query"
                name: "max_distance_limit"
                orig: "max_distance_limit"
                reqd: false
                type: "`$NUMBER`"
              }
              {
                kind: "query"
                name: "name"
                orig: "name"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: 1
                kind: "query"
                name: "page_number"
                orig: "page_number"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: 10
                kind: "query"
                name: "page_size"
                orig: "page_size"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                kind: "query"
                name: "rating_key"
                orig: "rating_key"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "sort_option_key"
                orig: "sort_option_key"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/Establishments"
          parts: [
            "Establishments"
          ]
          select: {
            exist: [
              "address"
              "business_type_id"
              "latitude"
              "local_authority_id"
              "longitude"
              "max_distance_limit"
              "name"
              "page_number"
              "page_size"
              "rating_key"
              "sort_option_key"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/Establishments/{id}"
          parts: [
            "Establishments"
            "{id}"
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.Geocode`"
          }
        }
      ]
    }
  }



}
