# Entity: rating

main: kit: entity: rating: {

  alias: field: {}

  fields: [
    {
      name: "ratingId"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "ratingKey"
      req: false
      type: "`$STRING`"
    }
    {
      name: "ratingName"
      req: false
      type: "`$STRING`"
    }
    {
      name: "schemeType"
      req: false
      type: "`$STRING`"
    }
  ]

  name: "rating"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/Ratings"
          parts: [
            "Ratings"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.ratings`"
          }
        }
      ]
    }
  }



}
